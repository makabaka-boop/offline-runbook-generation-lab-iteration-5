{
  "name": "offline-manual-kiosk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "断网可用的机房断电步骤手册（离线优先，原子安装与切换）",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-catalog.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run build && playwright test"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.0",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.24.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
